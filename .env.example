# ── Server Configuration ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (SQLite on Local / Mount disk on Render) ─────────
SQLITE_PATH=./database/renalcare.sqlite

# ── Alert Engine Clinical Thresholds ──────────────────────────
ALERT_POTASSIUM_CRITICAL=6.0
ALERT_POTASSIUM_WARNING=5.5
ALERT_EGFR_CRITICAL=15.0
ALERT_CREATININE_HIGH=5.0

